---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SYSTEM // TERMINAL" pathname="/s0hamd008-terminal" hideHeaderFooter={true}>
  <div class="fixed inset-0 bg-black z-[100] text-green-500 font-mono p-8 overflow-auto">
    <h1 class="text-3xl font-bold mb-6 text-green-400">SohamOS Backend Panel v1.0</h1>
    <div class="border border-green-500/30 p-6 bg-green-900/10 mb-8">
      <p class="mb-2">> INITIALIZING SYSTEM CHECK...</p>
      <p class="mb-2">> ASTRO HYBRID RENDERER: <span class="text-white">ONLINE</span></p>
      <p class="mb-2">> REACT SERVER: <span class="text-white">HYDRATED</span></p>
      <p class="mb-2">> CLOUDFLARE EDGE NET: <span class="text-white">CONNECTED</span></p>
      <p class="mb-2">> SECURITY PROTOCOL: <span class="text-white">OMNIVERSAL</span></p>
      <p class="mt-6">> WELCOME BACK, ADMIN. ALL SYSTEMS ARE NOMINAL.</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
       <div class="border border-green-500/30 p-4 relative">
          <h2 class="text-xl mb-4 text-green-300">SERVER RAM</h2>
          <div class="text-4xl">42%</div>
       </div>
       <div class="border border-green-500/30 p-4 relative">
          <h2 class="text-xl mb-4 text-green-300">REQUESTS/s</h2>
          <div class="text-4xl">14</div>
       </div>
       <div class="border border-green-500/30 p-4 relative">
          <h2 class="text-xl mb-4 text-green-300">UPTIME</h2>
          <div class="text-4xl">99.99%</div>
       </div>
    </div>

    <div class="mt-12 text-center text-sm opacity-50">
      <a href="/" class="hover:text-white hover:underline">> DISCONNECT AND RETURN TO HOMEPAGE</a>
    </div>
  </div>
</Layout>
